# ==============================================================================
# DAPH EP MIS - UPLOADS SECURITY SHIELD
# ==============================================================================
# Prevent execution of any scripts uploaded by users
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|phar|inc|pl|cgi|asp|aspx|sh|bash|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable CGI execution and directory listings
Options -Indexes -ExecCGI
